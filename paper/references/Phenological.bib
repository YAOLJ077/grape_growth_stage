@article{parkerClassificationVarietiesTheir2013,
  title = {Classification of Varieties for Their Timing of Flowering and Veraison Using a Modelling Approach: {{A}} Case Study for the Grapevine Species {{Vitis}} Vinifera {{L}}.},
  shorttitle = {Classification of Varieties for Their Timing of Flowering and Veraison Using a Modelling Approach},
  author = {Parker, Amber and {de Cort{\'a}zar-Atauri}, Inaki Garcia and Chuine, Isabelle and Barbeau, G{\'e}rard and Bois, Benjamin and Boursiquot, Jean-Michel and Cahurel, Jean-Yves and Claverie, Marion and Dufourcq, Thierry and G{\'e}ny, Laurence and Guimberteau, Guy and Hofmann, Rainer W. and Jacquet, Olivier and Lacombe, Thierry and Monamy, Christine and Ojeda, Hernan and Panigai, Laurent and Payan, Jean-Christophe and Lovelle, Bego{\~n}a Rodriquez and Rouchaud, Emmanuel and Schneider, Christophe and Spring, Jean-Laurent and Storchi, Paolo and Tomasi, Diego and Trambouze, William and Trought, Michael and {van Leeuwen}, Cornelis},
