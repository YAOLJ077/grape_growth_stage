@article{tanOvercomingMechanisticLimitationsa,
  title = {Overcoming Mechanistic Limitations of Process-Based Phenological Models: {{A}} Data Clustering Method for Large-Scale Applications},
  author = {Tan, Jiaojiao and Zhao, Gang and Tian, Qi and Zheng, Lei and Kang, Xiaofeng and He, Qinsi and Shi, Yu and Wu, Dingrong and Yao, Ning and He, Liang and Srivastava, Amit Kumar and Li, Yi and He, Jianqiang and Feng, Hao and Yu, Qiang},
  abstract = {Process-based phenological models use thermal requirement (TR) defined by temperature and photoperiod to predict crop developmental stages. The TR value for a specific developmental stage for a given variety is often presumed to be constant regardless of environmental conditions. We analyzed TR values for one rice (Oryza sativa L.) variety (`Shanyou 63'), calculated by 12 phenological models using 27 years of data from 46 sites in southern China. Our findings indicated that shifts in environmental conditions significantly affected TR values, e.g., standard deviations of TR at physiological maturation ranged from 83 to 167 \textcelsius{} d. Clustering sites together minimized environmental heterogeneity, and thus minimized the differences in TR for different phenological stages. When cluster number was increased from 1 to 24, simulation errors for the 12 models were consistently reduced from 1.7 to 1.4 days for tillering, from 5.1 to 3.8 days for jointing, from 5.4 to 3.8 days for booting, from 4.6 to 3.3 days for heading, and from 6.5 to 3.7 days for physiological maturation. Furthermore, our findings indicated that models incorporating an optimum temperature range rather than one optimum temperature simulated rice phenology more accurately. These models that defined one specific optimum temperature (To) performed poorly due to the sharp decline in the development rate at temperatures greater than To. This difference was attributed to different mechanisms used to describe the response of crop development rate to temperature, particularly at non-optimum temperatures. Our results demonstrated that clustering can effectively compensate for the lack of crop adaptation processes in common phenological models, leading to significantly improved phenological prediction accuracy in regions with environmental diversity.},
  langid = {english},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/GTDAAL78/Tan et al. - Overcoming mechanistic limitations of process-based phenological models A data clustering method fo.pdf}
}

@article{tomasiGrapevinePhenologyClimate2011,
  title = {Grapevine {{Phenology}} and {{Climate Change}}: {{Relationships}} and {{Trends}} in the {{Veneto Region}} of {{Italy}} for 1964--2009},
  shorttitle = {Grapevine {{Phenology}} and {{Climate Change}}},
  author = {Tomasi, Diego and Jones, Gregory V. and Giust, Mirella and Lovat, Lorenzo and Gaiotti, Federica},
  year = 2011,
  month = sep,
  journal = {American Journal of Enology and Viticulture},
  volume = {62},
  number = {3},
  pages = {329--339},
  issn = {0002-9254},
  doi = {10.5344/ajev.2011.10108},
  urldate = {2023-07-08},
  abstract = {A long-term (1964--2009), multiple Vitis vinifera L. cultivar data set has provided a comprehensive assessment of cultivar similarities/differences in phenological timing and growth phases and relationships with climate and climate change in the Veneto region of Italy. The budbreak to harvest period for the cultivars studied covered mid-April to late September, averaging 156 days but varying 55 days across cultivars. The main phenological events and intervals between events exhibited a 25 to 45 day variation between the earliest and latest years, with the bloom to veraison growth interval showing the lowest vintage-to-vintage variation. From 1964--2009, trends of 13 to 19 days earlier were found for bloom, veraison, and harvest dates, while budbreak exhibited high interannual variation and no trend. There were similar characteristics and trends for the main phenological events for early, middle, and late maturing cultivars, although early maturing cultivars changed at a higher rate. Changes in climate in the region led to significant breakpoints in the phenology time series, averaging 1990--1991 across all cultivars, with early and middle cultivars shifting sooner than late cultivars. Growing season average temperatures warmed 2.3{$^\circ$}C from 1964--2009, while annual and seasonal precipitation amounts did not change significantly. From 1964--2009, the growing period climate differences were 2.0{$^\circ$}C between the years with the shortest and the longest budbreak to harvest intervals. The combined trends in phenology and climate resulted in an average shift of eight days per 1.0{$^\circ$}C of warming. The extremely warm summer of 2003 (compressed growth intervals) and warm spring of 2007 (shifts in phenological timing) provide analog conditions to those projected for later this century.},
  langid = {english},
  file = {F:\YAO_2023\Grape\文献\Phenological\GrapevinePhenologyandClimateChangeRelationshipsandTrendsintheVenetoRegionofItalyfor19642009.pdf}
}

