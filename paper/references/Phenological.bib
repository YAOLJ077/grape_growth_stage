@article{fragaModellingClimateChange2016,
  title = {Modelling Climate Change Impacts on Viticultural Yield, Phenology and Stress Conditions in {{Europe}}},
  author = {Fraga, Helder and Garc{\'i}a De Cort{\'a}zar Atauri, I{\~n}aki and Malheiro, Aureliano C. and Santos, Jo{\~a}o A.},
  year = 2016,
  month = nov,
  journal = {Global Change Biology},
  volume = {22},
  number = {11},
  pages = {3774--3788},
  issn = {1354-1013, 1365-2486},
  doi = {10.1111/gcb.13382},
  urldate = {2026-06-30},
  abstract = {Viticulture is a key socio-economic sector in Europe. Owing to the strong sensitivity of grapevines to atmospheric factors, climate change may represent an important challenge for this sector. This study analyses viticultural suitability, yield, phenology, and water and nitrogen stress indices in Europe, for present climates (1980--2005) and future (2041--2070) climate change scenarios (RCP4.5 and 8.5). The STICS crop model is coupled with climate, soil and terrain databases, also taking into account CO2 physiological effects, and simulations are validated against observational data sets. A clear agreement between simulated and observed phenology, leaf area index, yield and water and nitrogen stress indices, including the spatial differences throughout Europe, is shown. The projected changes highlight an extension of the climatic suitability for grapevines up to 55{$^\circ$}N, which may represent the emergence of new winemaking regions. Despite strong regional heterogeneity, mean phenological timings (budburst, flowering, veraison and harvest) are projected to undergo significant advancements (e.g. budburst/harvest can be {$>$}1 month earlier), with implications also in the corresponding phenophase intervals. Enhanced dryness throughout Europe is also projected, with severe water stress over several regions in southern regions (e.g. southern Iberia and Italy), locally reducing yield and leaf area. Increased atmospheric CO2 partially offsets dryness effects, promoting yield and leaf area index increases in central/northern Europe. Future biomass changes may lead to modifications in nitrogen demands, with higher stress in northern/central Europe and weaker stress in southern Europe. These findings are critical decision support systems for stakeholders from the European winemaking sector.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
}

@article{fragaStatisticalModellingGrapevine2016,
  title = {Statistical Modelling of Grapevine Phenology in {{Portuguese}} Wine Regions: Observed Trends and Climate Change Projections},
  shorttitle = {Statistical Modelling of Grapevine Phenology in {{Portuguese}} Wine Regions},
  author = {Fraga, H. and Santos, J. A. and {Moutinho-Pereira}, J. and Carlos, C. and Silvestre, J. and {Eiras-Dias}, J. and Mota, T. and Malheiro, A. C.},
  year = 2016,
  month = jul,
  journal = {The Journal of Agricultural Science},
  volume = {154},
  number = {5},
  pages = {795--811},
  issn = {0021-8596, 1469-5146},
  doi = {10.1017/S0021859615000933},
  urldate = {2023-06-02},
  abstract = {Phenological models are considered key tools for the short-term planning of viticultural activities and long-term impact assessment of climate change. In the present study, statistical phenological models were developed for budburst (BUD), flowering (FLO) and veraison (VER) of 16 grapevine varieties (autochthonous and international) from the Portuguese wine-making regions of Douro, Lisbon and Vinhos Verdes. For model calibration, monthly averages of daily minimum (Tmin), maximum (Tmax) and mean (Tmean) temperatures were selected as potential regressors by a stepwise methodology. Significant predictors included Tmin in January--February--March for BUD, Tmax in March--April for FLO, and Tmin, Tmax and Tmean in March--July for VER. Developed models showed a high degree of accuracy after validation, representing 0{$\cdot$}71 of total variance for BUD, 0{$\cdot$}83 for FLO and 0{$\cdot$}78 for VER. Model errors were in most cases {$<$} 5 days, outperforming classic growing degree-day models, including models based on optimized temperature thresholds for each variety. Applied to the future scenarios RCP4{$\cdot$}5/8{$\cdot$}5, projections indicate earlier phenophase onset and shorter interphases for all varieties. These changes may bring significant challenges to the Portuguese wine-making sector, highlighting the need for suitable adaptation/mitigation strategies, to ensure its future sustainability.},
  langid = {english},
}

